# Copy to .env and replace both values with independently generated secrets.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=app
POSTGRES_USER=app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_DEBUG=false
DJANGO_SECURE_SSL_REDIRECT=false
DEFAULT_FROM_EMAIL=no-reply@localhost
# Optional SMTP settings. The console backend is used unless EMAIL_BACKEND is set.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# Override only if a different catalog pricing adapter is used.
# BILLING_PERIOD_PRICING_PROVIDER=products.services.billing_adapter.price_subscription_period
